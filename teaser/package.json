{
  "name": "nexen-enterprise-v1-teaser",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion teaser for NEXEN ENTERPRISE V1 built from real Playwright captures",
  "scripts": {
    "capture": "node capture/capture.js",
    "studio": "remotion studio src/index.ts",
    "frames": "remotion render src/index.ts Teaser out/frames --sequence --image-format=png --browser-executable=\"C:/Program Files/Google/Chrome/Application/chrome.exe\"",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534"
  }
}
